# ---- Voice + review provider (pick one; Gemini has a free tier) ----
# Google Gemini API key (https://aistudio.google.com/apikey). When set, voice runs on the
# Gemini Live API and session reviews on Gemini Flash, both free-tier eligible.
GEMINI_API_KEY=
# OpenAI key (paid). Used when GEMINI_API_KEY is absent, or when VOICE_PROVIDER/REVIEW_PROVIDER=openai.
OPENAI_API_KEY=
# Optional explicit choice: gemini | openai (default: gemini if GEMINI_API_KEY is set)
VOICE_PROVIDER=
REVIEW_PROVIDER=

# ---- Letta (long-term learner memory) ----
# Letta Cloud API key (https://app.letta.com -> API keys). When set, learner state lives in Letta.
LETTA_API_KEY=
# Optional: self-hosted Letta server instead of Letta Cloud, e.g. http://localhost:8283
LETTA_BASE_URL=
# Model handle used by the Letta agent (provider/model)
LETTA_MODEL=openai/gpt-5.6-luna

# ---- Optional tuning ----
GEMINI_LIVE_MODEL=gemini-3.8-live
GEMINI_LIVE_VOICE=Kore
GEMINI_REVIEW_MODELS=gemini-3.8-flash,gemini-3.5-flash-lite
OPENAI_REALTIME_MODEL=gpt-realtime-2.1
OPENAI_REALTIME_VOICE=marin
OPENAI_REVIEW_MODEL=gpt-5.6-luna
LEARNER_ID=mirza
LEARNER_NAME=Mirza
# Only used when LETTA_API_KEY / LETTA_BASE_URL are not set (local file store, dev only)
DATA_DIR=./data
