# ---- Required ----
# OpenAI key used server-side to mint short-lived realtime client secrets and to run session reviews.
OPENAI_API_KEY=sk-...

# ---- Letta (long-term learner memory) ----
# Letta Cloud API key (https://app.letta.com -> API keys). When set, learner state lives in Letta.
LETTA_API_KEY=
# Optional: self-hosted Letta server instead of Letta Cloud, e.g. http://localhost:8283
LETTA_BASE_URL=
# Model handle used by the Letta agent (provider/model)
LETTA_MODEL=openai/gpt-4.1

# ---- Optional tuning ----
OPENAI_REALTIME_MODEL=gpt-realtime-2.1
OPENAI_REALTIME_VOICE=marin
OPENAI_REVIEW_MODEL=gpt-5.6-luna
LEARNER_ID=mirza
LEARNER_NAME=Mirza
# Only used when LETTA_API_KEY / LETTA_BASE_URL are not set (local file store, dev only)
DATA_DIR=./data
