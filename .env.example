# ---- REQUIRED: GEMINI_API_KEY ----
# Free Google Gemini API key (https://aistudio.google.com/apikey). Powers voice
# (Gemini Live API) and session reviews (Gemini Flash), both free-tier eligible.
# Run `npm run setup` and it fills this in for you.
GEMINI_API_KEY=

# ---- Optional ----
# Long-term learner memory: Letta Cloud (https://app.letta.com -> API keys) or a
# self-hosted Letta server. Without these, progress is saved locally in ./data/
# on this computer instead.
LETTA_API_KEY=
LETTA_BASE_URL=
LETTA_MODEL=openai/gpt-5.6-luna

# OpenAI (paid alternative to Gemini). Used when GEMINI_API_KEY is absent, or
# when VOICE_PROVIDER/REVIEW_PROVIDER=openai.
OPENAI_API_KEY=

# Explicit provider choice: gemini | openai (default: gemini if GEMINI_API_KEY is set)
VOICE_PROVIDER=
REVIEW_PROVIDER=

# ---- Your name ----
# Left blank on purpose: `npm run setup` fills these in for you.
# LEARNER_ID keeps separate learners' progress apart on this machine.
LEARNER_NAME=
LEARNER_ID=

# ---- Optional tuning ----
GEMINI_LIVE_MODEL=gemini-3.8-live
GEMINI_LIVE_VOICE=Kore
GEMINI_REVIEW_MODELS=gemini-3.8-flash,gemini-3.5-flash-lite
OPENAI_REALTIME_MODEL=gpt-realtime-2.1
OPENAI_REALTIME_VOICE=marin
OPENAI_REVIEW_MODEL=gpt-5.6-luna
# Only used when LETTA_API_KEY / LETTA_BASE_URL are not set (local file store, dev only)
DATA_DIR=./data
